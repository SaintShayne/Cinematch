# Copy this file to .env and fill in your values

# Poster APIs
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# Chat
GROQ_API_KEY=your_groq_api_key_here

# Backend URL (used by legacy Streamlit app only — not needed for Next.js)
BACKEND_API_URL=http://127.0.0.1:8000

# CORS — comma-separated allowed origins for production
# Leave as * for local development
# Example for production: https://cinebot.vercel.app,https://www.cinebot.app
ALLOWED_ORIGINS=*
