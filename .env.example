# Copy this file to .env and fill in your values

# ── Backend ───────────────────────────────────────────────────────────────────

# Poster APIs (get TMDB key at themoviedb.org, OMDB at omdbapi.com)
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# AI chat (get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# CORS — comma-separated allowed origins
# Local:      ALLOWED_ORIGINS=*
# Production: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key bypasses RLS — backend only, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Frontend dev server URL ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Telegram (report forwarding + admin 2FA) ──────────────────────────────────
# Create a bot via @BotFather, get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Stripe (support page payments) ────────────────────────────────────────────
# Get from dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# Get from dashboard.stripe.com → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here