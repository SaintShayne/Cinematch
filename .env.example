# Copy this file to .env and fill in your values

# ── Backend ───────────────────────────────────────────────────────────────────

# Poster APIs (get TMDB key at themoviedb.org, OMDB at omdbapi.com)
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# AI chat (get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# CORS — comma-separated allowed origins
# Local:      ALLOWED_ORIGINS=*
# Production: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Get Supabase values from: supabase.com → project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000

