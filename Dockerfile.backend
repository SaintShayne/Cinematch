## ── CineMatch Backend — Dockerfile ──────────────────────────────────────────
## Multi-stage build: keeps the final image lean by separating the dependency
## install stage from the runtime stage.

# ── Stage 1: dependency install ───────────────────────────────────────────────
FROM python:3.11-slim AS deps

WORKDIR /install

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/deps -r requirements.txt


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# Non-root user for security
RUN addgroup --system app && adduser --system --ingroup app app

WORKDIR /app

# Copy pre-installed packages from stage 1
COPY --from=deps /deps /usr/local

# Copy source code
COPY src/ ./src/
COPY data/ ./data/
COPY cache/ ./cache/

# Set Python path so `src.*` imports resolve
ENV PYTHONPATH=/app

# Expose FastAPI port
EXPOSE 8000

# Drop to non-root
USER app

# Uvicorn with a single worker (scale horizontally via orchestrator)
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
